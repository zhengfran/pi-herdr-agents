{
  "status": {
    "enabled": true
  },
  "autoRouting": {
    "version": 1,
    "mode": "off"
  },
  "jevRouter": {
    "version": 1,
    "enabled": false
  },
  "models": {
    "agents": {}
  },
  "roles": {
    "bundled": true
  },
  "persistent": {
    "maxAgents": 3
  },
  "supervision": {
    "forcePolling": false,
    "hangWarningMinutes": 15
  },
  "panes": {
    "mode": "grouped",
    "direction": "right",
    "maxPerTab": 4
  }
}
